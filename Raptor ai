<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Raptor Ghost - MT5 Control</title>
<style>/* same design as screenshot - dark #080a0f gold #f5c518 */ body{margin:0;background:#080a0f;color:#fff;font-family:Inter,sans-serif}
.card{background:#11141e;border:1px solid #232a3e;border-radius:14px;padding:16px;margin:12px}
.gold{color:#f5c518} .btn-gold{background:#f5c518;color:#000;padding:14px;width:100%;border-radius:10px;font-weight:700;border:none}
.btn-green{background:#0a7a4a} .btn-red{background:#b91c2c}
input,select{width:100%;padding:12px;background:#0d111d;border:1px solid #2a3147;border-radius:10px;color:#fff;margin:8px 0}
canvas{width:100%;height:80px}</style></head>
<body>
<div style="padding:12px;background:#0f1422;border-bottom:1px solid #222"> <b style="color:#f5c518">RAPTOR GHOST</b> <span id="status">● DISCONNECTED</span></div>
<div class="card"><div class="gold">🛡️ MT5 ACCOUNT</div>
<select id="broker"><option>Exness</option><option>XM</option></select>
<input id="login" placeholder="Login 56197382">
<input id="pass" type="password" placeholder="Password">
<select id="server"><option>Exness-Real23</option><option>Exness-Real</option></select>
<button class="btn-gold" onclick="connectReal()">⚡ CONNECT ACCOUNT</button>
</div>
<div class="card"><div class="gold">📊 LIVE ANALYSIS</div><canvas id="chart"></canvas>
<div>🔍 Detecting market <span id="d1" style="color:#00ff88">●</span></div>
<div>📈 Calibrating stop loss <span id="d2" style="color:#00ff88">●</span></div>
<div>🤖 AI scoring: <span id="score">88/100 High Confidence</span></div>
</div>
<div class="card"><div class="gold">🤖 BOT CONTROL</div>
<select id="botType"><option value="safe">Phantom V13 Safe Elite (0.01/$10)</option><option value="elite">Phantom V13 Elite Copy (0.03 fixed)</option><option value="balance">Phantom V13 Balance Adaptive</option></select>
<div style="display:flex;gap:10px;margin-top:10px"><button class="btn-green" style="flex:1;padding:12px;border-radius:10px;border:none;color:#fff" onclick="startReal()">▶ START BOT</button><button class="btn-red" style="flex:1;padding:12px;border-radius:10px;border:none;color:#fff" onclick="stopReal()">■ STOP BOT</button></div>
<div id="trades"></div>
</div>
<script>
let bal=15.0; let chart=[20,22,19,24,26,23,28]; let ctx=document.getElementById('chart').getContext('2d');
function draw(){ctx.clearRect(0,0,300,80);ctx.strokeStyle='#f5c518';ctx.beginPath();chart.forEach((v,i)=>{let x=i/6*300,y=80-v;if(i==0)ctx.moveTo(x,y);else ctx.lineTo(x,y)});ctx.stroke()}
draw();
async function connectReal(){
 let body={login:login.value,password:pass.value,server:server.value,broker:broker.value};
 let r=await fetch('/api/connect',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
 let j=await r.json(); if(j.connected){status.innerText='● CONNECTED';status.style.color='#00ff88'; alert('MT5 Connected! Balance: '+j.balance)} else alert(j.error)
}
async function startReal(){
 let r=await fetch('/api/trade',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'start',login:login.value,botType:botType.value})});
 let j=await r.json(); alert(j.started?'Bot started on real account!':'Error')
}
async function stopReal(){
 await fetch('/api/trade',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'stop',login:login.value})});
}
</script>
</body></html>